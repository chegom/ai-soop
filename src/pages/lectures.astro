---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import InstructorCard from '../components/InstructorCard.astro';
import { withBase } from '../lib/url';
import { getEvents, getInstructors } from '../lib/content';

const { upcoming, past } = await getEvents();
const lectures = [...upcoming, ...past].filter((event) => event.data.kind === '강의');
const instructors = await getInstructors();
---

<Base title="강의" description="AI 숲 강의 프로그램과 강사 소개입니다. 강의 의뢰는 AI 숲으로 보내 주세요.">
  <section class="page-intro">
    <div class="wrap">
      <p class="eyebrow">강의</p>
      <h1>강의 프로그램</h1>
      <p class="lede">강사는 사진, 이름, 주제, 짧은 경력만 둡니다. 개인 연락처는 적지 않고, 강사마다 강의 의뢰 창구를 두지 않습니다. 강의 의뢰는 AI 숲 문의로 보내 주세요.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={withBase('join')}>참가 신청</a>
        <a class="text-link" href={withBase('contact')}>강의·제휴 문의</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="program-title">
    <div class="wrap">
      <h2 id="program-title">프로그램</h2>
      <div class="stack" style="margin-top: 16px">
        {lectures.map((event) => <EventCard {...event.data} />)}
      </div>
      {lectures.length === 0 && <p class="lede">등록된 강의가 없습니다. src/data/events.yaml 에 kind: 강의 로 추가하세요.</p>}
    </div>
  </section>

  <section class="section" aria-labelledby="lecture-people-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="lecture-people-title">강사</h2>
        <a href={withBase('instructors')}>강사 소개</a>
      </div>
      <div class="card-grid">
        {instructors.map((person) => <InstructorCard {...person.data} />)}
      </div>
    </div>
  </section>
</Base>
