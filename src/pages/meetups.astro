---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { withBase } from '../lib/url';
import { formatMonth } from '../lib/format';
import { getEvents } from '../lib/content';

const { upcoming, past } = await getEvents();
const upcomingMeetups = upcoming.filter((event) => event.data.kind === '모임');
const pastMeetups = past.filter((event) => event.data.kind === '모임');

function groupByMonth(events: typeof upcomingMeetups) {
  const groups = new Map<string, typeof upcomingMeetups>();
  for (const event of events) {
    const key = event.data.date.slice(0, 7);
    const list = groups.get(key) ?? [];
    list.push(event);
    groups.set(key, list);
  }
  return [...groups.entries()];
}
---

<Base title="모임" description="AI 숲의 온라인·오프라인 모임 일정입니다.">
  <section class="page-intro">
    <div class="wrap">
      <p class="eyebrow">모임</p>
      <h1>함께 모이는 자리</h1>
      <p class="lede">구로와 홍대, 온라인에서 일과 창작에 써 본 방법을 나눕니다. 참가는 신청 폼으로 이어지고, 강의 의뢰는 모임 카드가 아니라 AI 숲 문의로 받습니다.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={withBase('join')}>참가 신청</a>
        <a class="text-link" href={withBase('gallery')}>지난 모임 사진</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="upcoming-meetup-title">
    <div class="wrap">
      <h2 id="upcoming-meetup-title">예정된 모임</h2>
      {groupByMonth(upcomingMeetups).map(([month, events]) => (
        <div class="month-block">
          <h3>{formatMonth(`${month}-01`)}</h3>
          <div class="stack">
            {events.map((event) => <EventCard {...event.data} />)}
          </div>
        </div>
      ))}
      {upcomingMeetups.length === 0 && <p class="lede">예정된 모임이 없습니다. src/data/events.yaml 에 kind: 모임 으로 추가하세요.</p>}
    </div>
  </section>

  <section class="section" aria-labelledby="past-meetup-title">
    <div class="wrap">
      <h2 id="past-meetup-title">지난 모임</h2>
      <div class="stack" style="margin-top: 12px">
        {pastMeetups.map((event) => <EventCard {...event.data} />)}
      </div>
    </div>
  </section>
</Base>
