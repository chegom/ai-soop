---
import Base from '../layouts/Base.astro';
import ForestHero from '../components/ForestHero.astro';
import InstructorCard from '../components/InstructorCard.astro';
import InquiryBand from '../components/InquiryBand.astro';
import ExampleBadge from '../components/ExampleBadge.astro';
import { withBase } from '../lib/url';
import { dateParts, formatDate, formatPostDate } from '../lib/format';
import { getEvents, getGallery, getInstructors, getPartners, getPosts, getSite } from '../lib/content';

const site = await getSite();
const { upcoming, past } = await getEvents();
const nextMeetup = upcoming.find((event) => event.data.kind === '모임');
const nextLecture = upcoming.find((event) => event.data.kind === '강의');
const lectures = [...upcoming, ...past].filter((event) => event.data.kind === '강의');
const meetupWhen = nextMeetup ? dateParts(nextMeetup.data.date) : null;
const lectureWhen = nextLecture ? dateParts(nextLecture.data.date) : null;
const instructors = await getInstructors();
const partners = await getPartners();
const posts = (await getPosts()).slice(0, 3);
const photos = (await getGallery()).slice(0, 3);
---

<Base title={site.name}>
  <ForestHero />

  <section class="next-band" id="next" aria-labelledby="next-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="next-title">다가오는 모임과 강의</h2>
        <a href={withBase('schedule')}>전체 일정</a>
      </div>
      <div class="pillar-grid">
        <article class="pillar-card">
          <p class="eyebrow">모임</p>
          {nextMeetup && meetupWhen ? (
            <>
              <div class="pillar-date">
                <strong>{meetupWhen.month}/{meetupWhen.day}</strong>
                <span>{meetupWhen.weekday}요일 · {nextMeetup.data.time}</span>
              </div>
              <h3>{nextMeetup.data.title}</h3>
              <p class="next-meta">{nextMeetup.data.place} · {nextMeetup.data.mode}</p>
              <p>{nextMeetup.data.summary}</p>
              <div class="pillar-actions">
                <ExampleBadge show={nextMeetup.data.example} />
                <a class="button button-primary" href={withBase('join')}>참가 신청</a>
                <a class="text-link" href={withBase('meetups')}>모임 보기</a>
              </div>
            </>
          ) : (
            <>
              <h3>예정된 모임이 없습니다</h3>
              <a class="text-link" href={withBase('meetups')}>모임 보기</a>
            </>
          )}
        </article>
        <article class="pillar-card">
          <p class="eyebrow">강의</p>
          {nextLecture && lectureWhen ? (
            <>
              <div class="pillar-date">
                <strong>{lectureWhen.month}/{lectureWhen.day}</strong>
                <span>{lectureWhen.weekday}요일 · {nextLecture.data.time}</span>
              </div>
              <h3>{nextLecture.data.title}</h3>
              <p class="next-meta">{nextLecture.data.place} · {nextLecture.data.mode}</p>
              <p>{nextLecture.data.summary}</p>
              <div class="pillar-actions">
                <ExampleBadge show={nextLecture.data.example} />
                <a class="button button-primary" href={withBase('join')}>참가 신청</a>
                <a class="text-link" href={withBase('lectures')}>강의 보기</a>
              </div>
            </>
          ) : (
            <>
              <h3>예정된 강의가 없습니다</h3>
              <a class="text-link" href={withBase('lectures')}>강의 보기</a>
            </>
          )}
        </article>
      </div>
      <dl class="record">
        {site.stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="memory-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">모임</p>
          <h2 id="memory-title">지난 모임</h2>
        </div>
        <a href={withBase('gallery')}>활동 모두 보기</a>
      </div>
      <p class="lede section-lede">큰 단체 사진 대신, 테이블과 노트처럼 가까운 장면으로 시작합니다. 파일을 더하면 같은 칸이 늘어납니다.</p>
      <div class="memory-grid">
        {photos.map((photo) => (
          <figure class="memory-card">
            <img src={withBase(photo.data.image)} alt={photo.data.caption} width="800" height="1000" />
            <figcaption>
              <ExampleBadge show={photo.data.example} />
              <strong>{photo.data.title}</strong>
              <span>{formatDate(photo.data.date)} · {photo.data.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="lecture-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">강의</p>
          <h2 id="lecture-title">강의와 강사</h2>
        </div>
        <a href={withBase('lectures')}>강의 모두 보기</a>
      </div>
      <div class="stack">
        {lectures.map((event) => (
          <article class="event-card">
            <div class="meta">
              <ExampleBadge show={event.data.example} />
              <span class="pill">{event.data.mode}</span>
              <span class="pill pill-quiet">{event.data.status === 'upcoming' ? '예정' : '종료'}</span>
            </div>
            <p class="event-when">{formatDate(event.data.date)} · {event.data.time}</p>
            <h3>{event.data.title}</h3>
            <p>{event.data.place}</p>
            <p>{event.data.summary}</p>
          </article>
        ))}
      </div>
      <div class="section-head" style="margin-top: 48px">
        <h3 class="subhead">강사</h3>
        <a href={withBase('instructors')}>강사 소개</a>
      </div>
      <div class="card-grid">
        {instructors.map((person) => <InstructorCard {...person.data} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="post-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">자료</p>
          <h2 id="post-title">최근 자료</h2>
        </div>
        <a href={withBase('blog')}>자료 모두 보기</a>
      </div>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={withBase(`blog/${post.id}`)}>
              <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatPostDate(post.data.date)}</time>
              <strong>{post.data.title}</strong>
              <span>{post.data.description}</span>
              {post.data.example && <em>예시</em>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="partner-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">파트너</p>
          <h2 id="partner-title">함께 소개하는 이름</h2>
        </div>
        <a href={withBase('partners')}>제품 소개</a>
      </div>
      <ul class="logo-row">
        {partners.map((partner) => (
          <li>
            <strong>{partner.data.company}</strong>
            <span>{partner.data.product}{partner.data.example ? ' · 예시' : ''}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <InquiryBand />
</Base>
