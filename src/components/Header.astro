---
import { withBase } from '../lib/url';

const items = [
  { href: 'about', label: '소개' },
  { href: 'schedule', label: '일정' },
  { href: 'instructors', label: '강사' },
  { href: 'partners', label: '파트너' },
  { href: 'blog', label: '자료' },
  { href: 'gallery', label: '활동' },
  { href: 'contact', label: '문의' },
];

function normalize(path: string) {
  if (path.length > 1 && path.endsWith('/')) return path.slice(0, -1);
  return path || '/';
}

const current = normalize(Astro.url.pathname);
const home = normalize(withBase(''));

function currentAttr(href: string) {
  const target = normalize(withBase(href));
  const on = current === target || current.startsWith(`${target}/`);
  return on ? 'page' : undefined;
}
---

<header class="site-header">
  <a class="brand" href={withBase('')} aria-current={current === home ? 'page' : undefined}>
    <img src={withBase('favicon.svg')} alt="" width="34" height="34" />
    AI 숲
  </a>
  <nav class="desktop-nav" aria-label="주요 메뉴">
    {items.map((item) => (
      <a href={withBase(item.href)} aria-current={currentAttr(item.href)}>{item.label}</a>
    ))}
    <a class="button button-primary header-join" href={withBase('join')}>참가 신청</a>
  </nav>
  <details class="mobile-nav">
    <summary>메뉴</summary>
    <div class="mobile-nav-panel" role="navigation" aria-label="모바일 메뉴">
      {items.map((item) => (
        <a href={withBase(item.href)} aria-current={currentAttr(item.href)}>{item.label}</a>
      ))}
      <a href={withBase('join')}>참가 신청</a>
    </div>
  </details>
</header>
