<script>
  const root = document.querySelector('[data-forest]');
  if (root) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = window.matchMedia('(max-width: 760px)');
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    const layers = [...root.querySelectorAll<HTMLElement>('[data-depth]')];
    let pointerX = 0;
    let pointerY = 0;
    let frame = 0;

    const enabled = () => !reduce.matches && !narrow.matches && fine.matches;

    const paint = () => {
      frame = 0;
      if (!enabled()) {
        for (const layer of layers) layer.style.transform = '';
        return;
      }
      const rect = root.getBoundingClientRect();
      const scroll = Math.max(-0.2, Math.min(1.2, -rect.top / Math.max(rect.height, 1)));
      for (const layer of layers) {
        const depth = Number(layer.dataset.depth);
        const x = pointerX * depth * 28;
        const y = pointerY * depth * 14 + scroll * depth * 46;
        layer.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      }
    };

    const request = () => {
      if (!frame) frame = requestAnimationFrame(paint);
    };

    root.parentElement?.addEventListener('pointermove', (event) => {
      if (!enabled()) return;
      const rect = root.getBoundingClientRect();
      pointerX = (event.clientX - rect.left) / rect.width - 0.5;
      pointerY = (event.clientY - rect.top) / rect.height - 0.5;
      request();
    });

    window.addEventListener('scroll', request, { passive: true });
    reduce.addEventListener('change', request);
    narrow.addEventListener('change', request);
    fine.addEventListener('change', request);
    request();
  }
</script>
