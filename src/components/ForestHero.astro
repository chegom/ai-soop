  <div class="hero-fade" aria-hidden="true"></div>
  <div class="wrap hero-copy">
    <p class="eyebrow">온·오프라인 AI 모임</p>
    <h1 id="hero-title">서로 다른 사람들이<br />함께 자라는 숲</h1>
    <p class="lede">{site.description}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#next">다음 모임 보기</a>
      <a class="button button-secondary" href={withBase('join')}>참가 신청</a>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-forest]');
  if (root) {
    const ok = window.matchMedia('(min-width: 761px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches;
    if (ok) {
      const layers = root.querySelectorAll('[data-depth]');
      let tx = 0;
      let ty = 0;
      let sy = 0;
      const render = () => {
        layers.forEach((layer) => {
          const depth = Number(layer.getAttribute('data-depth'));
          const node = layer as HTMLElement;
          node.style.transform = `translate3d(${tx * depth}px, ${(ty + sy) * depth}px, 0)`;
        });
      };
      window.addEventListener('pointermove', (event) => {
        tx = event.clientX / (window.innerWidth || 1) - 0.5;
        ty = (event.clientY / (window.innerHeight || 1) - 0.5) * 0.65;
        render();
      }, { passive: true });
      window.addEventListener('scroll', () => {
        sy = Math.min(window.scrollY, 320) / 320 - 0.15;
        render();
      }, { passive: true });
    }
  }
</script>
