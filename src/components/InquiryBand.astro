---
import { isPlaceholder, withBase } from '../lib/url';
import { getSite } from '../lib/content';

const site = await getSite();
const placeholder = isPlaceholder(site.inquiryFormUrl);
---

<section class="section inquiry-band" id="inquiry" aria-labelledby="inquiry-title">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">한 곳으로 문의</p>
        <h2 id="inquiry-title">강의·제휴 문의는 AI 숲으로</h2>
      </div>
      <a href={withBase('contact')}>문의 안내</a>
    </div>
    <p class="lede section-lede">네 가지는 모두 같은 문의 폼으로 갑니다. 강사와 파트너에게 직접 보내지 않습니다.</p>
    {placeholder && <p class="lede">예시 주소입니다. 공개 전에 site.yaml의 inquiryFormUrl을 실제 폼으로 바꾸세요.</p>}
    <div class="inquiry-grid">
      {site.inquiryTypes.map((type) => (
        <a class="inquiry-card" href={site.inquiryFormUrl} target="_blank" rel="noopener noreferrer">
          <strong>{type.title}</strong>
          <span>{type.description}</span>
          <em>문의 폼 열기</em>
        </a>
      ))}
    </div>
  </div>
</section>
